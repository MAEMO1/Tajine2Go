{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/data/**",
              "components/core/**",
              "image-slot.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Geist))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Geist."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|width|assetsBase|key|ref|className|style|children)$/]",
        "message": "<ArchFrame> doesn't accept that prop. Declared props: children, width, assetsBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|onDark|onDarkOutline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'onDark' | 'onDarkOutline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|onDark|children|key|ref|className|style|children)$/]",
        "message": "<ContactRow> doesn't accept that prop. Declared props: icon, onDark, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactRow'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:phone|pin|mail|clock|instagram|facebook)$/]",
        "message": "<ContactRow> icon must be one of 'phone' | 'pin' | 'mail' | 'clock' | 'instagram' | 'facebook'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DishCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|image|badge|key|ref|className|style|children)$/]",
        "message": "<DishCard> doesn't accept that prop. Declared props: name, description, price, image, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onDark|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|note|key|ref|className|style|children)$/]",
        "message": "<OrderBar> doesn't accept that prop. Declared props: label, href, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ornament'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|flip|assetsBase|key|ref|className|style|children)$/]",
        "message": "<Ornament> doesn't accept that prop. Declared props: width, flip, assetsBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionDark'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionDark> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ArchFrame": {
        "replaces": []
